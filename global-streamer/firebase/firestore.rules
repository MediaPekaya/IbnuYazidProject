rules_version = '2';

// Global Streamer - peraturan Firestore (pelan percuma Spark).
// Prinsip:
//  * Tolak semua secara lalai.
//  * SESIAPA yang log masuk (Firebase Authentication) boleh mengurus data MILIKNYA SENDIRI. Tiada senarai UID.
//  * Admin ialah data: dokumen admins/{uid}. Ia hanya boleh ditambah melalui Firebase Console / Admin SDK
//    (klien tidak boleh menulis), jadi pengguna tidak boleh menaikkan taraf diri sendiri.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Peranan admin: pengguna hanya boleh semak sama ada DIRINYA admin. Tiada penulisan dari klien.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Profil pengguna: users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'game', 'templateId', 'createdAt', 'updatedAt'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (!('game' in request.resource.data) || (request.resource.data.game is string && request.resource.data.game.size() <= 40))
        && (!('templateId' in request.resource.data) || (request.resource.data.templateId is string && request.resource.data.templateId.size() <= 60));
      allow delete: if isOwner(uid);

      // Template buatan pengguna: users/{uid}/templates/{templateId}
      match /templates/{templateId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'game', 'data', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.game is string && request.resource.data.game.size() <= 40
          && request.resource.data.data is string && request.resource.data.data.size() <= 200000;
        allow delete: if isOwner(uid);
      }
    }

    // Lesen: licenses/{uid}. Pemilik boleh BACA lesen sendiri. Hanya admin boleh cipta/ubah/padam.
    match /licenses/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['active', 'plan', 'expiresAt', 'maxDevices', 'note', 'email', 'updatedAt'])
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Data meta game/tournament (disalin oleh pentadbir). Pengguna log masuk boleh baca sahaja.
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Selain itu: tutup.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
