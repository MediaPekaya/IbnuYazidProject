{
  "name": "global-streamer",
  "productName": "Global Streamer",
  "version": "0.2.0",
  "description": "Studio live seperti OBS dengan template, efek dan chat untuk TikTok, Facebook dan YouTube.",
  "main": "main/main.js",
  "private": true,
  "author": "Pekaya Media",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "dist": "electron-builder --win --x64",
    "check": "node scripts/check-syntax.js",
    "test:engine": "node scripts/test-engine.js",
    "check:i18n": "node scripts/check-i18n.js",
    "data:mlbb": "node scripts/data/collect-mlbb.js",
    "data:meta": "node scripts/data/collect-meta.js",
    "data:bundle": "node scripts/data/build-bundle.js",
    "test:data": "node scripts/test-data.js",
    "data:matches": "node scripts/data/collect-matches.js",
    "data:tournaments": "node scripts/data/collect-tournaments.js",
    "test:tourney": "node scripts/test-tourney.js",
    "test:reconnect": "node scripts/test-reconnect.js",
    "test:chat": "node scripts/test-chat.js",
    "test:icons": "node scripts/test-icons.js",
    "release:stage": "node scripts/release-stage.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pekaya.globalstreamer",
    "productName": "Global Streamer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "!renderer/site/**",
      "!renderer/updates/**",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Global Streamer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://global-streamer.web.app/updates/"
      }
    ]
  }
}
