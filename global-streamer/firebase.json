{
  "hosting": {
    "site": "global-streamer",
    "public": "renderer",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "updates/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/updates/:file", "destination": "https://github.com/GeniusDigitalDeveloper/global-streamer-releases-exe-apps/releases/latest/download/:file", "type": 302 },
      { "source": "/download/windows", "destination": "https://github.com/GeniusDigitalDeveloper/global-streamer-releases-exe-apps/releases/latest/download/Global-Streamer-Setup.exe", "type": 302 }
    ],
    "rewrites": [
      { "source": "/landing", "destination": "/site/index.html" },
      { "source": "/download", "destination": "/site/download.html" },
      { "source": "/privacy", "destination": "/site/privacy.html" },
      { "source": "/terms", "destination": "/site/terms.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self)" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://static.wikia.nocookie.net; media-src 'self' blob: mediastream: https://storage.googleapis.com https://api.elevenlabs.io; connect-src 'self' https://api.elevenlabs.io https://api.github.com https://graph.facebook.com ws://127.0.0.1:* ws://localhost:* wss://* https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com wss://*.firebaseio.com; frame-src https://*.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/landing",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/download",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/privacy",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/terms",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css|html|svg)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(png|ico|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
      },
      {
        "source": "/updates/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/data/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  }
}
