{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "stats": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "total": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "tools": {
        "$toolId": {
          ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
          ".validate": "$toolId.matches(/^[a-z0-9-]{2,40}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "daily": {
        "$date": {
          ".validate": "$date.matches(/^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$/)",
          "$toolId": {
            ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
            ".validate": "$toolId.matches(/^[a-z0-9-]{2,40}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "visits": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "users": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "total": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "daily": {
        "$date": {
          ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
          ".validate": "$date.matches(/^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "monthly": {
        "$month": {
          ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
          ".validate": "$month.matches(/^20[0-9]{2}-[0-1][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
